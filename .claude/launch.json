{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marline-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8473",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8473
    },
    {
      "name": "marline-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 8475
    },
    {
      "name": "marline-web-out",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8476",
        "--bind",
        "127.0.0.1",
        "--directory",
        "web/out"
      ],
      "port": 8476
    }
  ]
}
